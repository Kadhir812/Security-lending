# Custodian service. In Vite dev, localhost:8081 is automatically reached through
# the same-origin /api proxy so a browser CORS policy is not required locally.
VITE_CUSTODIAN_API_URL=http://localhost:8081
# Optional trusted pre-issued Custodian JWT for local development only.
# Do not commit valid tokens or HMAC signing keys; prefer the Token screen.
VITE_CUSTODIAN_JWT=
VITE_CUSTODIAN_ENV=local
