KAFKA_VERSION=4.4.0
KAFKA_CLUSTER_ID=R0PsJBAvTgyFquJzVCb0jA

FRONTEND_DIR=frontend
BACKEND_DIR=backend
KAFKA_HOME=kafka
KAFKA_RUNTIME_DIR=kafka-runtime
KAFKA_DATA_DIR=kafka-runtime/data
KAFKA_BROKER_LOG_DIR=kafka-runtime/brokER-logs
LOG_DIR=kafka-runtime/brokER-logs
KAFKA_LOG4J_OPTS=-Dlog4j2.configurationFile=kafka/config/tools-log4j2.yaml
APP_LOG_DIR=app-logs
PRODUCER_LOG_FILE=app-logs/producer.log
CONSUMER_LOG_FILE=app-logs/consumer.log
SCRIPTS_DIR=scripts
CONFIG_DIR=config

KAFKA_BOOTSTRAP_SERVER=localhost:9092
KAFKA_TOPIC=quickstart-events
